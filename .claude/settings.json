{
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "claude-md-management@claude-plugins-official": true,
    "ecc@ecc": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run verify)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(vercel:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.preview)",
      "Read(./.env.*.local)",
      "Read(./.vercel/.env*)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.development)",
      "Edit(./.env.test)",
      "Edit(./.env.staging)",
      "Edit(./.env.preview)",
      "Edit(./.env.*.local)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.production)",
      "Write(./.env.development)",
      "Write(./.env.test)",
      "Write(./.env.staging)",
      "Write(./.env.preview)",
      "Write(./.env.*.local)"
    ]
  }
}
