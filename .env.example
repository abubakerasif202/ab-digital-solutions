# Contact form delivery (app/api/contact/route.ts)
#
# Required for the enquiry form to deliver email. Without it the endpoint
# returns HTTP 503 and the form shows a message asking the visitor to email
# the studio directly — it never fails silently.
#
# Create the key at https://resend.com/api-keys and store it as a *sensitive*
# environment variable in Vercel (Production, Preview and Development).
# Never commit the real value.
RESEND_API_KEY=

# Optional. Overrides the sender address once a sending domain is verified in
# Resend. When unset, the code sends from
# "AB Web Studio <admin@abwebstudio.com.au>", which only works once that domain
# is verified in Resend — set this explicitly to control the sender.
CONTACT_FROM_EMAIL=

# Keep these unset until the branded mailbox exists and has been verified.
# NEXT_PUBLIC_CONTACT_EMAIL updates visible details, mailto links and JSON-LD.
# CONTACT_TO_EMAIL may route form delivery separately from the public address.
NEXT_PUBLIC_CONTACT_EMAIL=
CONTACT_TO_EMAIL=

# Recommended for production contact-form rate limiting. Create a free Redis
# database at Upstash and add its REST credentials in Vercel. When unset, local
# development uses a bounded in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ClickHouse analytics (optional)
# Use the HTTPS endpoint from ClickHouse Cloud or your own ClickHouse server.
# Keep these server-only. Never prefix credentials with NEXT_PUBLIC_.
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=web_events
