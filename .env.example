# Contact form delivery (app/api/contact/route.ts)
#
# Required for the enquiry form to deliver email. Without it the endpoint
# returns HTTP 503 and the form shows a message asking the visitor to email
# the studio directly — it never fails silently.
#
# Create the key at https://resend.com/api-keys and store it as a *sensitive*
# environment variable in Vercel (Production, Preview and Development).
# Never commit the real value.
RESEND_API_KEY=

# Optional. Overrides the sender address once a sending domain is verified in
# Resend. Falls back to Resend's shared onboarding sender when unset.
CONTACT_FROM_EMAIL=AB Digital Solutions <onboarding@resend.dev>

# Keep these unset until the branded mailbox exists and has been verified.
# NEXT_PUBLIC_CONTACT_EMAIL updates visible details, mailto links and JSON-LD.
# CONTACT_TO_EMAIL may route form delivery separately from the public address.
NEXT_PUBLIC_CONTACT_EMAIL=
CONTACT_TO_EMAIL=
